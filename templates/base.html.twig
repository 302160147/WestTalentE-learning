
<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}

        {% endblock %}

        {{ importmap('app') }}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>

    <body class="d-flex flex-column min-vh-100">

        <nav class="navbar navbar-expand-lg site-navbar">
            <div class="container-fluid px-3 px-lg-4">
                <a class="navbar-brand site-brand me-3" href="{{ path('app_home') }}">
                    <img src="{{ asset('/images/logo.svg') }}" alt="West Talent" height="38">
                </a>
                <a class="navbar-brand site-brand me-auto" href="{{ path('app_home') }}">
                    <img src="{{ asset('/images/logo.png') }}" alt="ROC Mondriaan" height="76">
                </a>

                <button class="navbar-toggler site-navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation" aria-expanded="false" aria-label="Navigatie openen">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavigation">
                    <ul class="navbar-nav site-nav mx-lg-auto">
                        <li class="nav-item">
                            <a href="{{ path('app_home') }}" class="nav-link site-nav-link{% if app.request.attributes.get('_route') == 'app_home' %} active{% endif %}">Home</a>
                        </li>

                        {% if app.user %}
                            <li class="nav-item">
                                <a href="{{ path('app_niveaus') }}" class="nav-link site-nav-link{% if app.request.attributes.get('_route') == 'app_niveaus' %} active{% endif %}">Niveaus</a>
                            </li>
                            <li class="nav-item">
                                <a href="{{ path('app_profile') }}" class="nav-link site-nav-link{% if app.request.attributes.get('_route') starts with 'app_profile' %} active{% endif %}">Profiel</a>
                            </li>
                        {% endif %}

                        {% if app.user and 'ROLE_ADMIN' in app.user.roles %}
                          <li class="nav-item">
                                <a class="nav-link site-nav-link{% if app.request.attributes.get('_route') == 'app_student_progress' %} active{% endif %}" href="{{ path('app_student_progress') }}">Studentvoortgang</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link site-nav-link" href="{{ path('admin') }}">Admin</a>
                            </li>
                        {% endif %}

                        {% if app.user and 'ROLE_TEACHER' in app.user.roles %}
                            <li class="nav-item">
                                <a class="nav-link site-nav-link" href="{{ path('teacher') }}">Leerkracht</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link site-nav-link{% if app.request.attributes.get('_route') == 'app_student_progress' %} active{% endif %}" href="{{ path('app_student_progress') }}">Studentvoortgang</a>
                            </li>
                        {% endif %}
                    </ul>

                    <div class="site-nav-actions">
                        {% if app.user %}
                            <a href="{{ path('app_profile') }}" class="site-user-name d-none d-xl-inline">{{ app.user.firstName }}</a>
                            <a href="{{ path('app_logout') }}" class="btn site-nav-action">Uitloggen</a>
                        {% else %}
                            <a href="{{ path('app_login') }}" class="btn site-nav-action">Inloggen</a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </nav>

        {% block body %}{% endblock %}

        <footer class="container-fluid site-footer mt-auto py-3">

            <div class="row">

                <div class="col-9">
                    <a class="navbar-brand" href="{{ path('app_home') }}">
                        <img src="{{ asset('/images/logo.svg') }}" class="img-fluid" alt="West Talent" width="200">
                    </a>

                    <a class="navbar-brand" href="{{ path('app_home') }}">
                        <img src="{{ asset('/images/logo.png') }}" class="img-fluid" alt="ROC Mondriaan" width="150">
                    </a>
                </div>

                <div class="col-2">
                    <ul>
                  

                    
                </div>

            </div>
        </footer>

    </body>
</html>
