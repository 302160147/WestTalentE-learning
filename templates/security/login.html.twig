{% extends 'base.html.twig' %}

{% block title %}Inloggen{% endblock %}

{% block body %}
    <main class="login-page">
        <div class="container py-4 py-lg-5">
            <section class="login-card">
                <div class="login-intro">
                    <h1>Welkom terug</h1>
                    <p>Log in om verder te gaan met je lessen.</p>
                </div>

                {% if error %}
                    <div class="alert alert-danger login-error" role="alert">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                {% if app.user %}
                    <div class="login-session-notice">
                        Je bent ingelogd als <strong>{{ app.user.userIdentifier }}</strong>.
                        <a href="{{ logout_path() }}">Uitloggen</a>
                    </div>
                {% else %}
                    <form method="post" class="login-form">
                        <div class="login-field">
                            <label for="username">E-mailadres</label>
                            <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="email" placeholder="naam@voorbeeld.nl" required autofocus>
                        </div>

                        <div class="login-field">
                            <label for="password">Wachtwoord</label>
                            <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" placeholder="Vul je wachtwoord in" required>
                        </div>

                        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                        <button class="btn login-submit" type="submit">
                            Inloggen
                            <span aria-hidden="true">&rarr;</span>
                        </button>
                    </form>
                {% endif %}
            </section>
        </div>
    </main>
{% endblock %}
