{% extends 'base.html.twig' %}

{% block title %}Studentvoortgang{% endblock %}

{% block body %}
    <main class="student-progress-page">
        <div class="container py-4 py-lg-5">
            <header class="student-progress-heading">
                <div>
                    <p class="module-eyebrow">Overzicht</p>
                    <h1>Studentvoortgang</h1>
                    <p>Kies een student om de voortgang en opdrachten in detail te bekijken.</p>
                </div>
            </header>

            {% for message in app.flashes('success') %}
                <div class="alert alert-success">{{ message }}</div>
            {% endfor %}

            <section class="student-progress-card">
                <div class="table-responsive">
                    <table class="table student-progress-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Student</th>
                                <th scope="col">Niveau</th>
                                <th scope="col">Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for row in studentRows %}
                                <tr>
                                    <th scope="row" class="student-name-cell">
                                        {{ row.student.firstName }} {{ row.student.lastName }}
                                    </th>
                                    <td>{{ row.niveau ? row.niveau.niveau : 'Niet toegewezen' }}</td>
                                    <td>
                                        <a class="btn btn-sm btn-primary text-nowrap" href="{{ path('app_student_progress_detail', {studentId: row.student.id}) }}">
                                            Bekijk voortgang
                                        </a>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="3" class="text-center text-muted py-4">
                                        Er zijn nog geen studenten geregistreerd.
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </main>
{% endblock %}
