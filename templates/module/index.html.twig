{% extends 'base.html.twig' %}

{% block title %}{{ module.name }}{% endblock %}

{% block body %}
<main class="module-page">
    <div class="container py-4 py-lg-5">
        <nav class="module-breadcrumb" aria-label="Kruimelpad">
            <a href="{{ path('app_niveaus') }}">Niveaus</a>
            <span aria-hidden="true">/</span>
            <span>{{ module.name }}</span>
        </nav>

        <header class="module-heading">
            <div>
                <h1>{{ module.name }}</h1>
            </div>
            <a href="{{ path('app_niveaus') }}" class="btn module-back-link">
                <span aria-hidden="true">&larr;</span>
                Terug naar niveaus
            </a>
        </header>

        <section aria-labelledby="lessons-heading">
            <div class="module-section-heading">
                <h2 id="lessons-heading">Lessen</h2>
            </div>

            <div class="row g-3 g-lg-4">
                {% for lesson in module.lessons %}
                    <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                        <a href="{{ path('app_lesson', {id: lesson.id}) }}" class="module-lesson-card">
                            <div class="module-lesson-number" aria-hidden="true">
                                {{ '%02d'|format(loop.index) }}
                            </div>
                            <div class="module-lesson-content">
                                <h3>{{ lesson.name }}</h3>
                                {% if lesson.description %}
                                    <p>{{ lesson.description }}</p>
                                {% else %}
                                    <p>Bekijk deze les en werk de opdracht uit.</p>
                                {% endif %}
                            </div>
                        </a>
                    </div>
                {% else %}
                    <div class="col-12">
                        <div class="module-empty-state">
                            <div class="module-empty-icon" aria-hidden="true">0</div>
                            <h3>Nog geen lessen</h3>
                            <p>Er zijn nog geen lessen aan deze module toegevoegd.</p>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </section>
    </div>
</main>
{% endblock %}
