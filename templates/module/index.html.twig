{% extends 'base.html.twig' %}

{% block body %}
<div class="container py-5">
    <h1 class="text-dark mb-4">{{ module.name }}</h1>
    <h2 class="text-dark mb-4">Lessen</h2>
    <div class="row g-3">

        {% for lesson in module.lessons %}

            <div class="col-6 col-md-3 col-lg-2">
                <div class="ratio ratio-1x1">
                    <a href="{{ path('app_lesson', {id: lesson.id}) }}"
                       class="d-block text-decoration-none">

                        <div class="card bg-white border-primary border-2 shadow-sm h-100">
                            <div class="card-body d-flex flex-column align-items-center justify-content-center text-center p-2">

                                <h3 class="text-black fs-6">{{ lesson.name }}</h3>

                                <p class="text-black small mb-0">
                                    {{ lesson.description }}
                                </p>

                            </div>
                        </div>

                    </a>

                </div>

            </div>
        {% else %}

            <p>Er zijn nog geen lessen toegevoegd.</p>

        {% endfor %}
    </div>

    <a href="{{ path('app_niveaus') }}" class="btn btn-outline-primary mt-4">
        Terug naar niveaus
    </a>
</div>
{% endblock %}