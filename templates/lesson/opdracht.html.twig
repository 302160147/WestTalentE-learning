{% extends 'base.html.twig' %}

{% block title %}Opdracht - {{ assignment.lesson.name }}{% endblock %}

{% block body %}
    <main class="assignment-page">
        <div class="container py-4 py-lg-5">
            <a class="assignment-back-link" href="{{ path('app_lesson', {'id': assignment.lesson.id}) }}">
                <span aria-hidden="true">&larr;</span>
                Terug naar les
            </a>

            <div class="assignment-layout">
                <section class="assignment-card" aria-labelledby="assignment-question-heading">
                    <p class="assignment-eyebrow">{{ assignment.questionType }}</p>
                    <h1 id="assignment-question-heading">Opdracht</h1>
                    <div class="assignment-question">
                        {% set description = assignment.question|split(',') %}
                        {% for item in description %}
                            <p>{{ item }}</p>
                        {% endfor %}
                    </div>

                    {% if assignment.questionType == 'Meerkeuze vraag' %}
                        {{ form_start(form, {attr: {class: 'assignment-answer-form'}}) }}
                            <div class="assignment-answer-field">
                                {{ form_row(form.answerOption, {label: 'Kies je antwoord'}) }}
                            </div>
                            <div class="visually-hidden">
                                {{ form_row(form.submittedAt) }}
                                {{ form_row(form.user) }}
                                {{ form_row(form.assignment) }}
                                {{ form_row(form.lesson) }}
                            </div>
                            {{ form_widget(form._token) }}
                            <button type="submit" class="btn assignment-submit">Verstuur antwoord</button>
                        {{ form_end(form, {render_rest: false}) }}
                    {% elseif assignment.questionType == 'Juist onjuist vraag' %}
                        {{ form_start(formJ, {attr: {class: 'assignment-answer-form'}}) }}
                            <div class="assignment-answer-field">
                                {{ form_row(formJ.answerOption, {label: 'Kies je antwoord'}) }}
                            </div>
                            <div class="visually-hidden">
                                {{ form_row(formJ.submittedAt) }}
                                {{ form_row(formJ.user) }}
                                {{ form_row(formJ.assignment) }}
                                {{ form_row(formJ.lesson) }}
                            </div>
                            {{ form_widget(formJ._token) }}
                            <button type="submit" class="btn assignment-submit">Verstuur antwoord</button>
                        {{ form_end(formJ, {render_rest: false}) }}
                    {% elseif assignment.questionType == 'Open vraag' %}
                        {{ form_start(formO, {attr: {class: 'assignment-answer-form'}}) }}
                            <div class="assignment-answer-field">
                                {{ form_row(formO.answerText, {label: 'Jouw antwoord'}) }}
                            </div>
                            <div class="visually-hidden">
                                {{ form_row(formO.submittedAt) }}
                                {{ form_row(formO.user) }}
                                {{ form_row(formO.assignment) }}
                                {{ form_row(formO.lesson) }}
                            </div>
                            {{ form_widget(formO._token) }}
                            <button type="submit" class="btn assignment-submit">Verstuur antwoord</button>
                        {{ form_end(formO, {render_rest: false}) }}
                    {% endif %}
                </section>
            </div>
        </div>
    </main>
{% endblock %}
