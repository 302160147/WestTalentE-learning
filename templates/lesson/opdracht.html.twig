{% extends 'base.html.twig' %}

{% block javascripts %}
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const optionSelect = document.getElementById('{{ form.answerOption.vars.id }}');
            const answerTextInput = document.getElementById('{{ form.answerText.vars.id }}');

            if (optionSelect && answerTextInput) {
                optionSelect.addEventListener('change', () => {
                    const selectedOption = optionSelect.options[optionSelect.selectedIndex];
                    answerTextInput.value = selectedOption.getAttribute('data-answer-text') || '';
                });
            }
        });
    </script>
{% endblock %}

{% block body %}
{#    {% for label, messages in app.flashes %}#}
{#        {% for message in messages %}#}
{#            <div class="alert alert-{{ label }}">#}
{#                {{ message }}#}
{#            </div>#}
{#        {% endfor %}#}
{#    {% endfor %}#}
    <div class="bg-info bg-gradient bg-opacity-50" style="height: 778px">
        <a class="btn btn-info" href="{{ path('app_lesson', {'id':assignment.lesson.id}) }}">terug naar les</a>

        <div class="container">
            <div class="row">
                <h1 class="rounded bg-light p-3">
                   <div>
                       {% set description = assignment.question|split(',') %}
                       {% for i in description|slice(0) %}
                           <h3>
                               {{ (i) }}
                           </h3>
                           <br>
                       {% endfor %}
                   </div>
                </h1>
                <div >
                    {{ form_start(form) }}
                    {{ form_row(form.answerText,{
                        label: 'Antwoord'
                    }) }}
                    {{ form_row(form.answerOption) }}
                    <div class="visually-hidden" >
                        {{ form_row(form.submittedAt) }}
                        {{ form_row(form.user,) }}
                        {{ form_row(form.assignment) }}
{#                        {% for option in assignment.answerOptions %}#}
{#                            {% if option.id !== null %}#}
{#                                {{ form_row(form.answerOption) }}#}
{#                            {% endif %}#}
{#                        {% endfor %}#}
                        {{ form_row(form.lesson) }}
                    </div>
                    {% for option in assignment.answerOptions %}
                        {% if option.id !== null %}
{#                            {{ form_row(form.answerOption) }}#}
                            {% set choices = option.optionText|split(',') %}
                            {% for i in choices|slice(0) %}
                                <input class="form-check-input"
                                       id="options"
                                       type="checkbox"
                                       name="question_{{ assignment.id }}"
                                       value="{{ option.id }}">
                                <label class="form-check-label">
                                    {{ (i) }}
                                </label>
                                <br>
                            {% endfor %}
                        {% endif %}
                    {% endfor %}
                    {{ form_widget(form._token) }}
                    <button type="submit" class="btn btn-info">Verstuur</button>
                    {{ form_end(form, {'render_rest': false}) }}
                </div>
            </div>
        </div>
    </div>

{% endblock %}

