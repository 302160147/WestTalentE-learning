{% extends 'base.html.twig' %}

{% block body %}
    <div class="bg-info bg-gradient bg-opacity-50" style="height: 778px">
        <a class="btn btn-info" href="{{ path('app_lesson', {'id':assignment.lesson.id}) }}">terug naar les</a>

        <div class="container">
            <div class="row">
                <h1 class="rounded bg-light p-3">
                   <div>
                       {% set description = assignment.question|split(',') %}
                       {% for i in description|slice(0) %}
                           <h3>
                               {{ (i) }}
                           </h3>
                           <br>
                       {% endfor %}
                   </div>
                </h1>
                {% if assignment.questionType == 'Meerkeuze vraag'  %}
                    <div>
                        {{ form_start(form) }}
                        {{ form_row(form.answerOption) }}
                        <div class="visually-hidden" >
                            {{ form_row(form.submittedAt) }}
                            {{ form_row(form.user) }}
                            {{ form_row(form.assignment) }}
                            {{ form_row(form.lesson) }}
                        </div>
                        {{ form_widget(form._token) }}
                        <button type="submit" class="btn btn-info">Verstuur</button>
                        {{ form_end(form, {'render_rest': false}) }}
                    </div>
                {% elseif assignment.questionType == 'Juist onjuist vraag'  %}
                    <div>
                        {{ form_start(formJ) }}
                        {{ form_row(formJ.answerOption) }}
                        <div class="visually-hidden" >
                            {{ form_row(formJ.submittedAt) }}
                            {{ form_row(formJ.user) }}
                            {{ form_row(formJ.assignment) }}
                            {{ form_row(formJ.lesson) }}
                        </div>
                        {{ form_widget(formJ._token) }}
                        <button type="submit" class="btn btn-info">Verstuur</button>
                        {{ form_end(formJ, {'render_rest': false}) }}
                    </div>
                {% elseif assignment.questionType == 'Open vraag' %}
                    <div>
                        {{ form_start(formO) }}
                        {{ form_row(formO.answerText,{
                            label: 'Antwoord'
                        }) }}
                        <div class="visually-hidden" >
                            {{ form_row(formO.submittedAt) }}
                            {{ form_row(formO.user) }}
                            {{ form_row(formO.assignment) }}
                            {{ form_row(formO.lesson) }}
                        </div>
                        {{ form_widget(formO._token) }}
                        <button type="submit" class="btn btn-info">Verstuur</button>
                        {{ form_end(formO, {'render_rest': false}) }}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

{% endblock %}

