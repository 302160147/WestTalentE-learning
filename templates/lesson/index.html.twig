{% extends 'base.html.twig' %}

{% block title %}{{ lesson.name }}{% endblock %}

{% block javascripts %}
<script>
    function showLessonPage(value) {
        document.querySelectorAll('[data-lesson-page]').forEach(function (page) {
            page.classList.toggle('d-none', page.dataset.lessonPage !== value);
        });
    }
</script>
{% endblock %}

{% block body %}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} lesson-flash">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <main class="lesson-page">
        <div class="container py-5">
            <nav class="module-breadcrumb" aria-label="Kruimelpad">
                {% if lesson.module and lesson.module.niveau %}
                    <a href="{{ path('app_module', {niveau: lesson.module.niveau.id, module: lesson.module.id}) }}">
                        {{ lesson.module.name }}
                    </a>
                {% else %}
                    <a href="{{ path('app_niveaus') }}">Niveaus</a>
                {% endif %}
                <span aria-hidden="true">/</span>
                <span>{{ lesson.name }}</span>
            </nav>

            <header class="lesson-heading">
                <div>
                    {% if lesson.module %}
                        <p class="module-eyebrow">{{ lesson.module.name }}</p>
                    {% else %}
                        <p class="module-eyebrow">Les</p>
                    {% endif %}
                    <h1>{{ lesson.name }}</h1>
                    {% if lesson.description %}
                        <p class="lesson-heading-description">{{ lesson.description }}</p>
                    {% endif %}
                </div>
                {% if lesson.module and lesson.module.niveau %}
                    <a href="{{ path('app_module', {niveau: lesson.module.niveau.id, module: lesson.module.id}) }}" class="btn lesson-back-link">
                        <span aria-hidden="true">&larr;</span>
                        Terug naar module
                    </a>
                {% endif %}
            </header>

            <div class="row g-4 align-items-start">
                <div class="col-lg-7">
                    <article class="lesson-content-card">
                        {% if lesson.contents %}
                            <div class="lesson-contents">
                                {{ lesson.contents|nl2br }}
                            </div>
                        {% endif %}

                        {% if lesson.pages|length > 0 %}
                            <div class="lesson-pages">
                                <label for="lesson-page-select" class="lesson-pages-label">Pagina kiezen</label>
                                <select id="lesson-page-select" onChange="showLessonPage(this.value)" class="form-select lesson-page-select">
                                    <option value="">Kies een pagina</option>
                                    {% for page in lesson.pages %}
                                        {% if page.lesson.id == lesson.id %}
                                            <option value="{{ page.id }}">{{ page.title }}</option>
                                        {% endif %}
                                    {% endfor %}
                                </select>

                                <div class="lesson-page-output">
                                    {% for page in lesson.pages %}
                                        <section id="{{ page.id }}" data-lesson-page="{{ page.id }}" class="lesson-page-content d-none">
                                            <p class="lesson-page-eyebrow">Pagina {{ loop.index }}</p>
                                            <h2>{{ page.title }}</h2>
                                            {% if page.info %}
                                                <p class="lesson-page-info">{{ page.info }}</p>
                                            {% endif %}
                                            {% if page.content %}
                                                <div>{{ page.content|nl2br }}</div>
                                            {% endif %}
                                        </section>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endif %}
                    </article>
                </div>

                <div class="col-lg-5">
                    <aside class="lesson-questions-card">
                        <div class="lesson-section-heading">
                            <div>
                                <p class="module-eyebrow">Toets je kennis</p>
                                <h2>Vragen</h2>
                            </div>
                            {% if lesson.assignments|length > 0 %}
                                <span class="module-count">{{ lesson.assignments|length }}</span>
                            {% endif %}
                        </div>

                        {% for assignment in lesson.assignments %}
                            <article class="lesson-question">
                                <div class="lesson-question-number">{{ loop.index }}</div>
                                <div class="lesson-question-body">
                                    <h3>
                                        {% set description = assignment.question|split(',') %}
                                        {% for item in description %}
                                            {{ item }}{% if not loop.last %}<br>{% endif %}
                                        {% endfor %}
                                    </h3>
                                    <span class="lesson-question-type">{{ assignment.questionType }}</span>
                                    <a href="{{ path('app_opdracht', {id: assignment.id}) }}" class="btn lesson-question-button">
                                        Maak vraag
                                        <span aria-hidden="true">&rarr;</span>
                                    </a>
                                    {% for submission in lesson.submissions %}
                                            {% if submission.assignment.id == assignment.id %}
                                                <a href="{{ path('app_lesson_feedback', {id: submission.id}) }}" class="btn lesson-question-button">
                                                    Feedback
                                                    <span aria-hidden="true">&rarr;</span>
                                                </a>
                                    {% endif %}
                                    {% endfor %}
                                </div>
                            </article>
                        {% else %}
                            <div class="lesson-empty-questions">
                                <p>Er zijn nog geen vragen toegevoegd aan deze les.</p>
                            </div>
                        {% endfor %}
                    </aside>
                </div>
            </div>
        </div>
    </main>
{% endblock %}
