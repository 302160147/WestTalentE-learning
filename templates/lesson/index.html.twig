{% extends 'base.html.twig' %}


{% block body %}
<div class="container bg-white py-5">

    <h1 class="text-dark mb-4">
        {{ lesson.name }}
    </h1>
    <div class="row g-4">
        <div class="col-lg-7">
            <p class="text-muted">
                {{ lesson.description }}
            </p>
            <hr>
            <div class="text-dark">
                {{ lesson.contents|nl2br }}
            </div>
            <div>
                <select class="form-select" aria-label="Default select example">
                    <option selected>Open this select menu</option>
                    <option value="1">One</option>
                    <option value="2">Two</option>
                    <option value="3">Three</option>
                </select>
                <div>

                </div>
                {% for page in lesson.pages %}
{#                    <a href="{{ path('app_opdracht', {'id':page.id}) }}">Pagina: {{ page.id }}</a>#}
                    <div>
                        {{ page.title }}
                        <br>
                        {{ page.info }}
                        <br>
                        {{ page.content|nl2br }}
                    </div>
                    <br>
                {% endfor %}
            </div>
        </div>
            <div class="col-lg-5">
{#                <div>#}
{#                    {{ form_start(submissionform) }}#}
{#                    {{ form_row(submissionform.user) }}#}
{#                    <button type="submit" class="btn btn-info">test</button>#}
{#                    {{ form_end(submissionform) }}#}
{#                </div>#}
                <form method="post" action="">
                    <h2 class="text-dark mb-4">Vragen</h2>

                    {% for assignment in lesson.assignments %}
                        {% if assignment.lesson.id == lesson.id %}
                            <a href="{{ path('app_opdracht', {id: assignment.id}) }}">
                            <button class="btn btn-info">Maak vraag</button>
                            </a>
                        {% endif %}
{#                        {{ lesson.id }}#}
{#                        {{ assignment.lesson.id }}#}
                        <div class="card shadow-sm border mb-4">

                            <div class="card-body p-4">

                                <h5 class="mb-3">
                                    {{ loop.index }}. {{ assignment.question }}
                                </h5>

                                {% if assignment.questionType == 'Meerkeuze vraag' %}

                                    {% for option in assignment.answerOptions %}
                                        <div class="form-check mb-2">
                                            {% set choices = option.optionText|split(',') %}
                                            {% for i in choices|slice(0) %}
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       name="question_{{ assignment.id }}"
                                                       value="{{ option.id }}">
                                                <label class="form-check-label">
                                                    {{ (i) }}
                                                </label>
                                                <br>
                                            {% endfor %}
                                        </div>
                                    {% endfor %}
                                {% elseif assignment.questionType == 'Juist onjuist vraag' %}

                                    {% for option in assignment.answerOptions %}
                                        <div class="form-check mb-2">
                                            {% set choices = option.optionText|split(',') %}
                                            {% for i in choices|slice(0) %}
                                                <input class="form-check-input"
                                                       type="radio"
                                                       name="question_{{ assignment.id }}"
                                                       value="{{ option.id }}">
                                                <label class="form-check-label">
                                                    {{ (i) }}
                                                </label>
                                                <br>
                                            {% endfor %}
                                        </div>
                                    {% endfor %}
                                {% elseif assignment.questionType == 'Open vraag' %}

                                    <textarea class="form-control"
                                              rows="4"
                                              placeholder="Typ je antwoord..."></textarea>

                                {% endif %}
                            </div>
                        </div>
                    {% else %}
                        <p class="text-muted">
                            Er zijn nog geen vragen toegevoegd aan deze les.
                        </p>

                    {% endfor %}
                    <button type="submit" class="btn btn-info">Gegevens updaten</button>
                </form>
            </div>
    </div>

</div>
{#<script src="/assets/pagina.js"></script>#}
{% endblock %}
