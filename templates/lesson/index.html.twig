{% extends 'base.html.twig' %}

{% block javascripts %}
 <script>
     function test(value){
         document.getElementById("pages").className = value;
         {% for page in lesson.pages %}
         console.log({{ page.id }})
         console.log(value)
            if ( value == {{ page.id }}){
                document.getElementById({{ page.id }}).className = value;
            } else {
                document.getElementById({{ page.id }}).className = "visually-hidden";
            }
         {% endfor %}
     }
 </script>
{% endblock %}

{% block body %}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}
    <div class="bg-info bg-gradient bg-opacity-50">
        <div class="container py-5">

            <h1 class="text-dark mb-4">
                {{ lesson.name }}
            </h1>
            <div class="row g-4">
                <div class="col-lg-7">
                    <p class="text-muted">
                        {{ lesson.description }}
                    </p>
                    <hr>
                    <div class="text-dark">
                        {{ lesson.contents|nl2br }}
                    </div>
                    <div>
                        <select onChange="test(this.value)" class="form-select" aria-label="Default select example">
                            <option>Kies je pagina.</option>
                            {% for page in lesson.pages %}
                                {% if page.lesson.id == lesson.id %}
                                    <option value="{{ page.id }}">{{ page.title }}</option>
                                {% endif %}
                            {% endfor %}
                        </select>
                        <div id="pages" class="0">
                            {% for page in lesson.pages %}

                                <div id="{{ page.id }}" class="visually-hidden">
                                    {{ page.title }}
                                    <br>
                                    {{ page.info }}
                                    <br>
                                    {{ page.content|nl2br }}
                                </div>
                                <br>
                            {% endfor %}
                        </div>
                    </div>
                </div>
                <div class="col-lg-5">
                    <form method="post" action="">
                        <h2 class="text-dark mb-4">Vragen</h2>

                        {% for assignment in lesson.assignments  %}

                            <div class="card shadow-sm border mb-4">

                                <div class="card-body p-4">

                                    <h5 class="mb-3">
                                        {{ loop.index }}.
                                        {% set description = assignment.question|split(',') %}
                                        {% for i in description|slice(0) %}
                                            <label class="form-check-label">
                                                {{ (i) }}
                                            </label>
                                            <br>
                                        {% endfor %}
                                    </h5>

                                    {% if assignment.questionType == 'Meerkeuze vraag' %}
                                        {% if assignment.lesson.id == lesson.id %}
                                            {% for submission in lesson.submissions|slice(1) %}
                                                {% if submission.user.id !== app.user.id %}
                                                    <a href="{{ path('app_opdracht', {id: assignment.id}) }}">
                                                        <button class="btn btn-info">Maak vraag</button>
                                                    </a>
                                                {% else %}
                                                    <div>Deze vraag is gemaakt!</div>
                                                {% endif %}
                                            {% endfor %}
                                        {% endif %}
                                    {% elseif assignment.questionType == 'Juist onjuist vraag' %}
                                        {% if assignment.lesson.id == lesson.id %}
{#                                            {% for submission in lesson.submissions %}#}
{#                                                {{ assignment.id }}#}
{#                                                {{ submission.assignment.id }}#}
{#                                            {% if assignment.id !== assignment.submissions.id %}#}
                                            <a href="{{ path('app_opdracht', {id: assignment.id}) }}">
                                                <button class="btn btn-info">Maak vraag</button>
                                            </a>
                                            {{ assignment.id }}
                                            {% for submission in submissions %}
                                            {{ submission.assignment.id }}
                                                {% if submission.assignment.id == assignment.id %}
                                                <div>hi</div>
                                                {% else %}
                                                <div>hello</div>
                                                {% endif %}
                                            {% endfor %}
{#                                            {% else %}#}
                                                <div>Deze vraag is gemaakt!</div>
{#                                            {% endif %}#}
{#                                            {% endfor %}#}
                                        {% endif %}
                                    {% elseif assignment.questionType == 'Open vraag' %}
                                        {% if assignment.lesson.id == lesson.id %}
                                            {% for submission in lesson.submissions|slice(1) %}
                                            {% if submission.user.id !== app.user.id %}
                                            <a href="{{ path('app_opdracht', {id: assignment.id}) }}">
                                                <button class="btn btn-info">Maak vraag</button>
                                            </a>
                                            {% else %}
                                                <div>Deze vraag is gemaakt!</div>
                                            {% endif %}
                                            {% endfor %}
                                        {% endif %}
                                    {% endif %}
                                </div>
                            </div>
                        {% else %}
                            <p class="text-muted">
                                Er zijn nog geen vragen toegevoegd aan deze les.
                            </p>
                        {% endfor %}
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
