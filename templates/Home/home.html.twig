{% extends 'base.html.twig' %}

{% block title %}West Talent E-Learning{% endblock %}

{% block body %}
    <div class="bg-info bg-gradient bg-opacity-50" style="height: 701px">
            <div class="container w-100">
                <div class="row">
                    <div class="col-12 text-center bg-info-subtle border p-3 m-3">
                        <h2>Welkom op West Talent E-Learning</h2>
                    </div>
                    <div class="col-12 text-center bg-info-subtle border m-3">
                        {% if app.user %}
                            <a href="#">
                                <button class="border rounded bg-info">Profiel</button>
                            </a>
                            <div>
                                <div class="card" style="width: 18rem;">
                                    <img src="{{ asset('/images/Maatschappij.jpg') }}" class="card-img-top" alt="Burgerschap">
                                    <div class="card-body">
                                        <h5 class="card-title">Burgerschap</h5>
                                        <p class="card-text">De Burgerschap niveau's, modules en lessen</p>
                                        <a href="{{ path('app_niveaus') }}" class="btn btn-primary">Open</a>
                                    </div>
                                </div>
                            </div>
                        {% else %}
                            <a href="{{ path('app_login') }}">
                                <button class="border rounded bg-info">Inloggen</button>
                            </a>
                        {% endif %}
                    </div>
                </div>
            </div>
    </div>
{% endblock %}
