{% extends 'base.html.twig' %}

{% block title %}West Talent E-Learning{% endblock %}

{% block body %}
    <main class="profile-page">
        <div class="container py-5">
            <div class="profile-heading mb-4">
                <div>
                    <span class="profile-eyebrow">Mijn account</span>
                    <h1 class="profile-title">Welkom terug, {{ app.user.firstName }}</h1>
                </div>
                <a href="{{ path('app_profile_update', {'id': app.user.id}) }}" class="btn profile-primary-btn">
                    Gegevens bewerken
                </a>
            </div>

            {% for message in app.flashes('success') %}
                <div class="alert alert-success profile-alert">{{ message }}</div>
            {% endfor %}

            <div class="row g-4">
                <div class="col-lg-4">
                    <section class="profile-card profile-summary h-100">
                        <div class="profile-avatar" aria-hidden="true">
                            {{ app.user.firstName|slice(0, 1)|upper }}{{ app.user.lastName|slice(0, 1)|upper }}
                        </div>
                        <h2>{{ app.user.firstName }} {{ app.user.lastName }}</h2>
                        <p class="profile-email">{{ app.user.email }}</p>
                        {% if app.user.isVerified %}
                            <span class="profile-status"><span aria-hidden="true">✓</span> Account geverifieerd</span>
                        {% endif %}

                        <div class="profile-card-header profile-data-header">
                            <div>
                                <span class="profile-eyebrow">Persoonlijk</span>
                                <h2>Mijn gegevens</h2>
                            </div>
                            <a href="{{ path('app_profile_update', {'id': app.user.id}) }}" class="profile-edit-link">Bewerken</a>
                        </div>
                        <dl class="profile-details">
                            <div>
                                <dt>Voornaam</dt>
                                <dd>{{ app.user.firstName }}</dd>
                            </div>
                            <div>
                                <dt>Achternaam</dt>
                                <dd>{{ app.user.lastName }}</dd>
                            </div>
                            <div>
                                <dt>E-mailadres</dt>
                                <dd>{{ app.user.email }}</dd>
                            </div>
                        </dl>
                    </section>
                </div>

                <div class="col-lg-8">
                    <section class="profile-card profile-courses">
                        <div class="profile-card-header">
                            <div>
                                <span class="profile-eyebrow">Mijn studie</span>
                                <h2>Modules en opdrachten</h2>
                            </div>
                        </div>

                        {% if app.user.niveau %}
                            <p class="profile-study-level">Jouw modules voor {{ app.user.niveau.niveau }}</p>

                            {% for module in modules %}
                                <article class="profile-module-card">
                                    <div class="profile-module-heading">
                                        <div>
                                            <span class="profile-eyebrow">Module {{ loop.index }}</span>
                                            <h3>{{ module.name }}</h3>
                                        </div>
                                        <a href="{{ path('app_module', {niveau: module.niveau.id, module: module.id}) }}" class="profile-edit-link">
                                            Open module
                                        </a>
                                    </div>

                                    {% for lesson in module.lessons %}
                                        <div class="profile-assignment-group">
                                            <h4>{{ lesson.name }}</h4>
                                            {% for assignment in lesson.assignments %}
                                                {% set isCompleted = completedAssignmentIds[assignment.id] is defined %}
                                                <div class="profile-assignment">
                                                    <div class="profile-assignment-info">
                                                        <p>{{ assignment.question }}</p>
                                                        <span>{{ assignment.questionType }}</span>
                                                    </div>
                                                    <span class="profile-assignment-status {{ isCompleted ? 'is-complete' : 'is-pending' }}">
                                                        {{ isCompleted ? 'Afgerond' : 'Nog te doen' }}
                                                    </span>
                                                    <a href="{{ isCompleted ? path('app_lesson', {id: lesson.id}) : path('app_opdracht', {id: assignment.id}) }}" class="profile-assignment-link">
                                                        {{ isCompleted ? 'Bekijk les' : 'Naar opdracht' }}
                                                    </a>
                                                </div>
                                            {% else %}
                                                <p class="profile-assignment-empty">Nog geen opdrachten in deze les.</p>
                                            {% endfor %}
                                        </div>
                                    {% else %}
                                        <p class="profile-assignment-empty">Er zijn nog geen lessen in deze module.</p>
                                    {% endfor %}
                                </article>
                            {% else %}
                                <p class="profile-assignment-empty">Er zijn nog geen modules voor jouw niveau.</p>
                            {% endfor %}
                        {% else %}
                            <p class="profile-assignment-empty">
                                Er is nog geen niveau aan je account gekoppeld. Vraag een leerkracht om dit in te stellen.
                            </p>
                        {% endif %}
                    </section>
                </div>
            </div>
        </div>
    </main>
{% endblock %}
