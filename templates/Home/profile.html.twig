{% extends 'base.html.twig' %}

{% block title %}West Talent E-Learning{% endblock %}

{% block body %}
    <main class="profile-page">
        <div class="container py-5">
            <div class="profile-heading mb-4">
                <div>
                    <span class="profile-eyebrow">Mijn account</span>
                    <h1 class="profile-title">Welkom terug, {{ app.user.firstName }}</h1>
                </div>
                <a href="{{ path('app_profile_update', {'id': app.user.id}) }}" class="btn profile-primary-btn">
                    Gegevens bewerken
                </a>
            </div>

            {% for message in app.flashes('success') %}
                <div class="alert alert-success profile-alert">{{ message }}</div>
            {% endfor %}

            <div class="row g-4">
                <div class="col-lg-4">
                    <section class="profile-card profile-summary h-100">
                        <div class="profile-avatar" aria-hidden="true">
                            {{ app.user.firstName|slice(0, 1)|upper }}{{ app.user.lastName|slice(0, 1)|upper }}
                        </div>
                        <h2>{{ app.user.firstName }} {{ app.user.lastName }}</h2>
                        <p class="profile-email">{{ app.user.email }}</p>
                        {% if app.user.isVerified %}
                            <span class="profile-status"><span aria-hidden="true">✓</span> Account geverifieerd</span>
                        {% endif %}

                        <div class="profile-card-header profile-data-header">
                            <div>
                                <span class="profile-eyebrow">Persoonlijk</span>
                                <h2>Mijn gegevens</h2>
                            </div>
                            <a href="{{ path('app_profile_update', {'id': app.user.id}) }}" class="profile-edit-link">Bewerken</a>
                        </div>
                        <dl class="profile-details">
                            <div>
                                <dt>Voornaam</dt>
                                <dd>{{ app.user.firstName }}</dd>
                            </div>
                            <div>
                                <dt>Achternaam</dt>
                                <dd>{{ app.user.lastName }}</dd>
                            </div>
                            <div>
                                <dt>E-mailadres</dt>
                                <dd>{{ app.user.email }}</dd>
                            </div>
                        </dl>
                    </section>
                </div>

                <div class="col-lg-8">
                    <section class="profile-card profile-courses h-100">
                        <div class="profile-card-header">
                            <div>
                                <span class="profile-eyebrow">Studieaanbod</span>
                                <h2>Mijn vakken</h2>
                            </div>
                        </div>
                        <div class="profile-course">
                            <div class="profile-course-icon" aria-hidden="true">B</div>
                            <div class="profile-course-info">
                                <h3>Burgerschap</h3>
                                <p>Kies een niveau om de modules te bekijken.</p>
                            </div>
                            <div class="profile-levels">
                                {% for level in 2..4 %}
                                    <div class="dropdown">
                                        <button class="btn profile-level-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            Niveau {{ level }}
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            {% for module in 1..4 %}
                                                <li><a class="dropdown-item" href="#">Module {{ module }}</a></li>
                                            {% endfor %}
                                        </ul>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    </main>
{% endblock %}
