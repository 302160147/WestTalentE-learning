{% extends 'base.html.twig' %}

{% block title %}West Talent E-Learning{% endblock %}

{% block body %}
    <main class="profile-page">
        <div class="container py-5">
            <div class="profile-edit-layout">
                <a href="{{ path('app_profile') }}" class="profile-back-link">
                    <span aria-hidden="true">←</span> Terug naar profiel
                </a>

                <section class="profile-card profile-edit-card">
                    <div class="profile-card-header mb-4">
                        <div>
                            <span class="profile-eyebrow">Accountinstellingen</span>
                            <h1 class="profile-form-title">Gegevens bewerken</h1>
                        </div>
                    </div>

                    {{ form_errors(form) }}
                    {{ form_start(form) }}
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label" for="profile-first-name">Voornaam</label>
                                <input id="profile-first-name" class="form-control profile-form-control" type="text" value="{{ form.vars.data.firstName }}" readonly>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="profile-last-name">Achternaam</label>
                                <input id="profile-last-name" class="form-control profile-form-control" type="text" value="{{ form.vars.data.lastName }}" readonly>
                            </div>
                            <div class="col-12">
                                {{ form_row(form.email, {
                                    label: 'E-mailadres',
                                    help: 'Je e-mailadres kan hier niet worden aangepast.',
                                    attr: {
                                        'class': 'form-control profile-form-control',
                                        'autocomplete': 'email',
                                        'inputmode': 'email'
                                    }
                                }) }}
                            </div>
                            <div class="col-12">
                                {{ form_row(form.password, {
                                    label: 'Nieuw wachtwoord',
                                    help: 'Laat leeg om je huidige wachtwoord te behouden.',
                                    attr: {'class': 'form-control profile-form-control'}
                                }) }}
                            </div>
                        </div>
                        <div class="profile-form-actions">
                            <a href="{{ path('app_profile') }}" class="btn profile-secondary-btn">Annuleren</a>
                            <button type="submit" class="btn profile-primary-btn">Wijzigingen opslaan</button>
                        </div>
                        {{ form_rest(form) }}
                    {{ form_end(form, {'render_rest': false}) }}
                </section>
            </div>
        </div>
    </main>
{% endblock %}
