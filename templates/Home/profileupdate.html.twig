{% extends 'base.html.twig' %}

{% block title %}West Talent E-Learning{% endblock %}

{% block body %}
    <div class="bg-info bg-gradient bg-opacity-50" style="height: 701px">
        <div class="container w-100">
            <h1>Gegevens bewerken</h1>
            <div class="row">
                <div>
                    {{ form_errors(form) }}

                    {{ form_start(form) }}
                    {{ form_row(form.firstName,{
                        label: 'Voornaam'
                    }) }}
                    {{ form_row(form.lastName,{
                        label: 'Achternaam'
                    }) }}
                    {{ form_row(form.email) }}
                    {{ form_row(form.password,{
                        label: 'Wachtwoord'
                    }) }}
                    <button type="submit" class="btn btn-info">Gegevens updaten</button>
                    {{ form_rest(form) }}
                    {{ form_end(form, {'render_rest': false}) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
